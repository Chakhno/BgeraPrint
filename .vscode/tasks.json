{
  // Ctrl+Shift+B runs the default one (all the tests).
  // Terminal menu -> Run Task... for the rest.
  //
  // These call Python directly rather than through the shell, because
  // VS Code opens PowerShell on Windows and PowerShell has no < operator.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Test: everything fast",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test: self test with the real programs",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "tests.selftest", "--keep", "${workspaceFolder}/selftest-output"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Test: self test, quick",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "tests.selftest", "--quick"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Play the badge session",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "tests.play", "tests/session_badge.txt", "--fresh"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Play the shapes session",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "tests.play", "tests/session_shapes.txt", "--fresh"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Georgian still to translate",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "bgera.texts"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Install what the app needs",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "pip", "install", "-r", "requirements.txt"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Build the exe (later, when you want one)",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": ["-m", "PyInstaller", "BgeraPrint.spec", "--noconfirm"],
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "clear": true },
      "problemMatcher": []
    }
  ]
}
